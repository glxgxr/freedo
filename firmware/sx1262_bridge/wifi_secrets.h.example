// Copy to wifi_secrets.h next to the sketch (git ignores it) to put the host link on the WLAN:
// the bridge then serves its serial protocol on TCP port 7820 to one client. The build holds
// the password, so keep the built image to yourself as well.
#define WIFI_SSID "my-wlan"
#define WIFI_PASSWORD "my-wlan-password"
// Optional: accept the TCP link only from this address, the host of the daemon.
// #define LINK_ALLOWED_IP 192, 168, 178, 10
